<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Welcome to HomeSync</title>

</head>

<body style="
    margin:0;
    padding:0;
    background-color:#f4f6fb;
    font-family:Arial, Helvetica, sans-serif;
    color:#172033;
">

    <!-- Outer Background -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6fb;">

        <tr>

            <td align="center" style="padding:45px 15px;">

                <!-- Main Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                    max-width:600px;
                    background-color:#ffffff;
                    border-radius:18px;
                    overflow:hidden;
                    box-shadow:0 12px 35px rgba(30,41,59,0.10);
                ">

                    <!-- Header -->
                    <tr>

                        <td align="center" style="
                            padding:38px 40px 35px;
                            background-color:#111827;
                        ">

                            <!-- Logo -->
                            <table cellpadding="0" cellspacing="0" border="0" align="center">

                                <tr>

                                    <td align="center" valign="middle" style="
                                        width:54px;
                                        height:54px;
                                        background-color:#6366f1;
                                        border-radius:15px;
                                        color:#ffffff;
                                        font-size:25px;
                                        font-weight:700;
                                    ">
                                        H
                                    </td>

                                </tr>

                            </table>

                            <!-- Brand -->
                            <h1 style="
                                margin:16px 0 0;
                                color:#ffffff;
                                font-size:27px;
                                line-height:34px;
                                font-weight:700;
                                letter-spacing:-0.5px;
                            ">
                                HomeSync
                            </h1>

                            <p style="
                                margin:7px 0 0;
                                color:#c7d2fe;
                                font-size:13px;
                                line-height:20px;
                            ">
                                Find your perfect home and roommate
                            </p>

                        </td>

                    </tr>

                    <!-- Main Content -->
                    <tr>

                        <td style="padding:42px 42px 40px;">

                            <!-- Success Badge -->
                            <table cellpadding="0" cellspacing="0" border="0" align="center"
                                style="margin-bottom:22px;">

                                <tr>

                                    <td align="center" valign="middle" style="
                                        width:48px;
                                        height:48px;
                                        border-radius:50%;
                                        background-color:#ecfdf5;
                                        color:#16a34a;
                                        font-size:23px;
                                        font-weight:700;
                                    ">
                                        ✓
                                    </td>

                                </tr>

                            </table>

                            <!-- Welcome Heading -->
                            <h2 style="
                                margin:0;
                                text-align:center;
                                font-size:28px;
                                line-height:36px;
                                color:#111827;
                                font-weight:700;
                                letter-spacing:-0.5px;
                            ">
                                Welcome to HomeSync!
                            </h2>

                            <p style="
                                margin:12px 0 28px;
                                text-align:center;
                                font-size:15px;
                                line-height:25px;
                                color:#64748b;
                            ">
                                Your email has been successfully verified.
                            </p>

                            <!-- Greeting -->
                            <p style="
                                margin:0 0 16px;
                                font-size:15px;
                                line-height:26px;
                                color:#475569;
                            ">
                                Hello
                                <strong style="color:#111827;">
                                    <%= name %>
                                </strong>,
                            </p>

                            <p style="
                                margin:0 0 18px;
                                font-size:15px;
                                line-height:26px;
                                color:#64748b;
                            ">
                                We're excited to have you with us. Your
                                <strong style="color:#111827;">HomeSync</strong>
                                account is now verified and ready to use.
                            </p>

                            <p style="
                                margin:0 0 30px;
                                font-size:15px;
                                line-height:26px;
                                color:#64748b;
                            ">
                                HomeSync makes it easier to discover suitable
                                properties, find compatible roommates, and manage
                                your rental journey from one place.
                            </p>

                            <!-- Features -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                                background-color:#f5f3ff;
                                border:1px solid #ddd6fe;
                                border-radius:14px;
                            ">

                                <tr>

                                    <td style="padding:22px 22px 8px;">

                                        <p style="
                                            margin:0;
                                            font-size:14px;
                                            line-height:22px;
                                            font-weight:700;
                                            color:#3730a3;
                                        ">
                                            What you can do with HomeSync
                                        </p>

                                    </td>

                                </tr>

                                <tr>

                                    <td style="padding:7px 22px;">

                                        <p style="
                                            margin:0;
                                            font-size:14px;
                                            line-height:23px;
                                            color:#475569;
                                        ">
                                            <strong style="color:#6366f1;">✓</strong>
                                            Discover suitable properties for rent
                                        </p>

                                    </td>

                                </tr>

                                <tr>

                                    <td style="padding:7px 22px;">

                                        <p style="
                                            margin:0;
                                            font-size:14px;
                                            line-height:23px;
                                            color:#475569;
                                        ">
                                            <strong style="color:#6366f1;">✓</strong>
                                            Find compatible roommates
                                        </p>

                                    </td>

                                </tr>

                                <tr>

                                    <td style="padding:7px 22px;">

                                        <p style="
                                            margin:0;
                                            font-size:14px;
                                            line-height:23px;
                                            color:#475569;
                                        ">
                                            <strong style="color:#6366f1;">✓</strong>
                                            Apply for available rooms
                                        </p>

                                    </td>

                                </tr>

                                <tr>

                                    <td style="padding:7px 22px 20px;">

                                        <p style="
                                            margin:0;
                                            font-size:14px;
                                            line-height:23px;
                                            color:#475569;
                                        ">
                                            <strong style="color:#6366f1;">✓</strong>
                                            Manage your rental and payments with ease
                                        </p>

                                    </td>

                                </tr>

                            </table>

                            <!-- CTA -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:30px;">

                                <tr>

                                    <td align="center">

                                        <a href="<%= loginUrl %>" style="
                                            display:inline-block;
                                            padding:13px 28px;
                                            background-color:#6366f1;
                                            color:#ffffff;
                                            text-decoration:none;
                                            font-size:14px;
                                            line-height:20px;
                                            font-weight:700;
                                            border-radius:9px;
                                        ">
                                            Get Started
                                        </a>

                                    </td>

                                </tr>

                            </table>

                            <!-- Closing -->
                            <p style="
                                margin:32px 0 0;
                                font-size:14px;
                                line-height:23px;
                                color:#475569;
                            ">
                                We're happy to have you as part of the
                                <strong style="color:#111827;">HomeSync</strong>
                                community.
                            </p>

                            <p style="
                                margin:22px 0 0;
                                font-size:14px;
                                line-height:23px;
                                color:#475569;
                            ">
                                Best regards,<br>

                                <strong style="color:#111827;">
                                    HomeSync Team
                                </strong>
                            </p>

                        </td>

                    </tr>

                    <!-- Footer -->
                    <tr>

                        <td align="center" style="
                            padding:24px 40px;
                            background-color:#f8fafc;
                            border-top:1px solid #eef2f7;
                        ">

                            <p style="
                                margin:0;
                                font-size:12px;
                                line-height:19px;
                                color:#94a3b8;
                            ">
                                This is an automated email. Please do not reply.
                            </p>

                            <p style="
                                margin:6px 0 0;
                                font-size:12px;
                                line-height:19px;
                                color:#cbd5e1;
                            ">
                                © <%= new Date().getFullYear() %> HomeSync. All rights reserved.
                            </p>

                        </td>

                    </tr>

                </table>

            </td>

        </tr>

    </table>

</body>

</html>
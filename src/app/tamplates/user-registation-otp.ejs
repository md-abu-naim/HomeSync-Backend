<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Verify Your Email - HomeSync</title>

</head>

<body style="
    margin:0;
    padding:0;
    background-color:#f4f6fb;
    font-family:Arial, Helvetica, sans-serif;
    color:#172033;
">

    <!-- Outer Background -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6fb;">

        <tr>

            <td align="center" style="padding:45px 15px;">

                <!-- Main Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                    max-width:600px;
                    background-color:#ffffff;
                    border-radius:18px;
                    overflow:hidden;
                    box-shadow:0 12px 35px rgba(30,41,59,0.10);
                ">

                    <!-- Brand Header -->
                    <tr>

                        <td align="center" style="
                            padding:34px 40px 32px;
                            background-color:#111827;
                        ">

                            <!-- Logo -->
                            <table cellpadding="0" cellspacing="0" border="0" align="center">

                                <tr>

                                    <td align="center" valign="middle" style="
                                        width:52px;
                                        height:52px;
                                        background-color:#6366f1;
                                        border-radius:14px;
                                        color:#ffffff;
                                        font-size:24px;
                                        font-weight:700;
                                    ">
                                        H
                                    </td>

                                </tr>

                            </table>

                            <!-- Brand Name -->
                            <h1 style="
                                margin:16px 0 0;
                                color:#ffffff;
                                font-size:26px;
                                line-height:32px;
                                font-weight:700;
                                letter-spacing:-0.5px;
                            ">
                                HomeSync
                            </h1>

                            <p style="
                                margin:7px 0 0;
                                color:#c7d2fe;
                                font-size:13px;
                                line-height:20px;
                            ">
                                Find your perfect home and roommate
                            </p>

                        </td>

                    </tr>

                    <!-- Content -->
                    <tr>

                        <td style="padding:42px 42px 40px;">

                            <!-- Greeting -->
                            <p style="
                                margin:0 0 8px;
                                font-size:14px;
                                line-height:22px;
                                color:#64748b;
                            ">
                                Welcome to HomeSync
                            </p>

                            <h2 style="
                                margin:0 0 18px;
                                font-size:27px;
                                line-height:36px;
                                color:#111827;
                                font-weight:700;
                                letter-spacing:-0.5px;
                            ">
                                Verify your email
                            </h2>

                            <p style="
                                margin:0 0 18px;
                                font-size:15px;
                                line-height:26px;
                                color:#475569;
                            ">
                                Hello
                                <strong style="color:#111827;">
                                    <%= name %>
                                </strong>,
                            </p>

                            <p style="
                                margin:0 0 30px;
                                font-size:15px;
                                line-height:26px;
                                color:#64748b;
                            ">
                                Thank you for creating your account with
                                <strong style="color:#111827;">HomeSync</strong>.
                                Please use the verification code below to confirm
                                your email address and complete your registration.
                            </p>

                            <!-- OTP Card -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                                background-color:#f5f3ff;
                                border:1px solid #ddd6fe;
                                border-radius:14px;
                            ">

                                <tr>

                                    <td align="center" style="padding:25px 20px 27px;">

                                        <p style="
                                            margin:0 0 10px;
                                            font-size:11px;
                                            line-height:16px;
                                            font-weight:700;
                                            letter-spacing:2px;
                                            text-transform:uppercase;
                                            color:#6366f1;
                                        ">
                                            Email Verification Code
                                        </p>

                                        <div style="
                                            font-size:36px;
                                            line-height:44px;
                                            font-weight:700;
                                            letter-spacing:9px;
                                            color:#111827;
                                        ">
                                            <%= otp %>
                                        </div>

                                    </td>

                                </tr>

                            </table>

                            <!-- Expiry -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">

                                <tr>

                                    <td align="center" style="padding:17px 0 0;">

                                        <p style="
                                            margin:0;
                                            font-size:13px;
                                            line-height:21px;
                                            color:#64748b;
                                        ">
                                            This code expires in
                                            <strong style="color:#111827;">
                                                5 minutes
                                            </strong>.
                                        </p>

                                    </td>

                                </tr>

                            </table>

                            <!-- Security Notice -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                                margin-top:30px;
                                background-color:#f8fafc;
                                border-radius:10px;
                            ">

                                <tr>

                                    <td style="padding:15px 17px;">

                                        <p style="
                                            margin:0;
                                            font-size:13px;
                                            line-height:21px;
                                            color:#64748b;
                                        ">
                                            <strong style="color:#334155;">
                                                Security notice:
                                            </strong>
                                            Never share this verification code with
                                            anyone. HomeSync will never ask you
                                            for this code.
                                        </p>

                                    </td>

                                </tr>

                            </table>

                            <!-- Didn't Request -->
                            <p style="
                                margin:27px 0 0;
                                font-size:13px;
                                line-height:22px;
                                color:#94a3b8;
                            ">
                                If you did not create a HomeSync account,
                                you can safely ignore this email.
                            </p>

                            <!-- Closing -->
                            <p style="
                                margin:28px 0 0;
                                font-size:14px;
                                line-height:23px;
                                color:#475569;
                            ">
                                Best regards,<br>

                                <strong style="color:#111827;">
                                    HomeSync Team
                                </strong>
                            </p>

                        </td>

                    </tr>

                    <!-- Footer -->
                    <tr>

                        <td align="center" style="
                            padding:24px 40px;
                            background-color:#f8fafc;
                            border-top:1px solid #eef2f7;
                        ">

                            <p style="
                                margin:0;
                                font-size:12px;
                                line-height:19px;
                                color:#94a3b8;
                            ">
                                This is an automated email. Please do not reply.
                            </p>

                            <p style="
                                margin:6px 0 0;
                                font-size:12px;
                                line-height:19px;
                                color:#cbd5e1;
                            ">
                                © <%= new Date().getFullYear() %> HomeSync. All rights reserved.
                            </p>

                        </td>

                    </tr>

                </table>

            </td>

        </tr>

    </table>

</body>

</html>
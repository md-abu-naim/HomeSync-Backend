model Room {
    id         String @id @default(uuid())
    propertyId String

    roomNumber  String
    title       String?
    description String?

    roomType RoomType @default(SINGLE)

    amount          Decimal  @db.Decimal(10, 2)
    securityDeposit Decimal? @db.Decimal(10, 2)

    capacity         Int @default(1)
    currentOccupants Int @default(0)

    availability RoomAvailability @default(AVAILABLE)

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    applications Rental[]
    payments     Payment[]

    @@unique([propertyId, roomNumber])
    @@index([propertyId])
    @@index([availability])
    @@index([roomType])
    @@index([amount])
    @@index([isDeleted])
    @@index([createdAt])
    @@map("rooms")
}

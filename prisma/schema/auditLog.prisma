model AuditLog {
  id         String   @id @default(uuid())
  
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action     String   
  entity     String   
  entityId   String?  
  details    Json?    
  ipAddress  String?

  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}